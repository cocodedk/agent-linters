# Normalize all text files to LF on commit
* text=auto eol=lf

# Extensionless files — git can't key off an extension that isn't there, so name them
# explicitly. Every executable here MUST stay LF: a CRLF shebang line fails to execute
# on Linux and macOS ("bad interpreter"), which is a confusing way to find this out.
/bin/lintp          text eol=lf
/shims/mypy         text eol=lf
/shims/biome        text eol=lf
/install.sh         text eol=lf
/config/mypy/config text eol=lf

# Explicitly declare common text files
*.py    text eol=lf
*.sh    text eol=lf
*.fish  text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.json  text eol=lf

# Binary files — never diff or convert
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.tar.gz  binary
